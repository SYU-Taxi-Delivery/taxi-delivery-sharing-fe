# Origin the browser calls for /api/*. Use this app's own origin together with
# BACKEND_ORIGIN so session and CSRF cookies stay first-party (e.g. http://localhost:3000).
# NEXT_PUBLIC_* values are included in the browser bundle; never put secrets here.
NEXT_PUBLIC_API_BASE_URL=
# Server-only: Spring backend that Next.js proxies /api/* and /logout to (e.g. http://localhost:8080).
BACKEND_ORIGIN=
